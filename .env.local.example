# Local dev env for running the dashboard app-template outside the E2B sandbox.
# Copy to `.env.local` (gitignored) and fill in. The real ALO_API_KEY must NEVER
# be committed. In the sandbox these are injected automatically; locally you
# supply them here. `dev_local.sh` loads this file before starting the backend.

# Platform API key for your space (sk-...). Held server-side only — the browser
# never sees it; the local FastAPI backend proxies to the hub with it.
ALO_API_KEY=sk-...

# Base URL of the Central Hub the backend proxies to (no trailing slash).
# Local hub: http://localhost:8082   |   or the deployed dev hub URL.
ALO_API_BASE_URL=http://localhost:8082

# Workspace slug (X-Space-Slug header). Match the space the key belongs to.
ALO_SPACE_SLUG=your-space-slug

# Optional: default model slug for the embedded assistant. Leave blank to let
# the agent fall back to the space-default model.
ALO_MODEL_SLUG=
